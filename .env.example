# Supabase project "kaafiye-spare-parts" → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SERVER ONLY. Used by admin/super-admin server actions to create & disable staff logins.
# Never prefix with NEXT_PUBLIC_, never commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Staff who log in with a username get this synthetic e-mail domain (no mail is ever sent).
STAFF_EMAIL_DOMAIN=staff.kaafiye.local
